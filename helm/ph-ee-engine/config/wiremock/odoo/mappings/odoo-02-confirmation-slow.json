{
  "name": "odoo-confirmation-slow",
  "priority": 0,
  "request": {
    "method": "POST",
    "urlPath": "/rest/Odoo+confirmation+Api+Mock/2.1.0/confirmation",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.saleId =~ /^slow-.*/)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 70000,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message": "Confirmation received"
    }
  }
}
