{
  "name": "fineract-payment-hub-confirmation",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/fineract-provider/api/v1/paymentHub/confirmation",
    "headers": {
      "Authorization": { "matches": "Bearer .+" },
      "fineract-platform-tenantid": { "matches": " *default" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$.RemoteTransactionId" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "status": "CONFIRMED"
    }
  }
}
