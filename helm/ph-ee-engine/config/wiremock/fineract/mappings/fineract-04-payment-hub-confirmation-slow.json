{
  "name": "fineract-payment-hub-confirmation-slow",
  "priority": 0,
  "request": {
    "method": "POST",
    "urlPath": "/fineract-provider/api/v1/paymentHub/confirmation",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.RemoteTransactionId =~ /^slow-.*/)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 70000,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "CONFIRMED"
    }
  }
}
