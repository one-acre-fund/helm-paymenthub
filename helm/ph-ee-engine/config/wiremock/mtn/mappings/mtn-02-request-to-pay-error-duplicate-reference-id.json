{
  "name": "mtn-collection-request-to-pay-error-duplicate-reference-id",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/collection/v1_0/requesttopay",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "X-Reference-Id": {
        "matches": ".+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.payer.partyId == '250780000002')]"
      }
    ]
  },
  "response": {
    "status": 409,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "RESOURCE_ALREADY_EXIST",
      "message": "Duplicated reference id. Creation of resource failed."
    }
  },
  "postServeActions": [
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8080/__admin/mappings",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"name\": \"mtn-collection-request-to-pay-status-duplicate-reference-id-{{originalRequest.headers.X-Reference-Id}}\", \"priority\": 1, \"request\": {\"method\": \"GET\", \"urlPath\": \"/collection/v1_0/requesttopay/{{originalRequest.headers.X-Reference-Id}}\"}, \"response\": {\"status\": 404, \"headers\": {\"Content-Type\": \"application/json\"}, \"jsonBody\": {\"code\": \"RESOURCE_NOT_FOUND\", \"message\": \"Requested resource was not found.\"}}}"
      }
    }
  ]
}
