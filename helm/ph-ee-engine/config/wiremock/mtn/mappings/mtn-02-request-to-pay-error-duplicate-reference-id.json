{
  "name": "mtn-collection-request-to-pay-error-duplicate-reference-id",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/collection/v1_0/requesttopay",
    "headers": {
      "Authorization": { "matches": "Bearer .+" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.payer.partyId == '250780000002')]" }
    ]
  },
  "response": {
    "status": 409,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "code": "RESOURCE_ALREADY_EXIST",
      "message": "Duplicated reference id. Creation of resource failed."
    }
  }
}
