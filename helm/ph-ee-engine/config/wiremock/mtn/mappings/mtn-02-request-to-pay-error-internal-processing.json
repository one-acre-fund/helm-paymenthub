{
  "name": "mtn-collection-request-to-pay-error-internal-processing",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/collection/v1_0/requesttopay",
    "headers": {
      "Authorization": { "matches": "Bearer .+" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.payer.partyId == '250780000003')]" }
