{
  "name": "mtn-collection-request-to-pay-status",
  "priority": 2,
  "request": {
    "method": "GET",
    "urlPathPattern": "/collection/v1_0/requesttopay/[^/]+",
    "headers": {
      "Authorization": { "matches": "Bearer .+" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "financialTransactionId": "{{substring (replace request.path.[3] '-' '') 0 12}}",
      "status": "SUCCESSFUL"
    },
    "transformers": ["response-template"]
  }
}
