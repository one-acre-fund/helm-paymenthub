{
  "name": "mpesa-buygoods-stkpush-initiate-callback-empty-body",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/mpesa/stkpush/v1/processrequest",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.TransactionType"
      },
      {
        "matchesJsonPath": "$[?(@.PhoneNumber == 254700000301)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "MerchantRequestID": "29115-34620561-1",
      "CheckoutRequestID": "ws_CO_{{jsonPath request.body '$.Timestamp'}}_EMPTYBODY",
      "ResponseCode": "0",
      "ResponseDescription": "Success. Request accepted for processing",
      "CustomerMessage": "Success. Request accepted for processing"
    },
    "transformers": [
      "response-template"
    ]
  },
  "postServeActions": [
    {
      "name": "webhook",
      "parameters": {
        "method": "POST",
        "url": "{{{jsonPath originalRequest.body '$.CallBackURL'}}}",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "",
        "delay": {
          "type": "fixed",
          "milliseconds": 3000
        }
      }
    }
  ]
}
