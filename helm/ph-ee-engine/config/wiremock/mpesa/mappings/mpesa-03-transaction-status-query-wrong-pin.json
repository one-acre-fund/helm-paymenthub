{
  "name": "mpesa-buygoods-transaction-status-query-wrong-pin",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/mpesa/stkpushquery/v2/query",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.CheckoutRequestID", "contains": "_WRONGPIN" } }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "ResponseCode": "0",
      "ResponseDescription": "The service request has been accepted successfully",
      "MerchantRequestID": "29115-34620561-1",
      "CheckoutRequestID": "{{jsonPath request.body '$.CheckoutRequestID'}}",
      "ResultCode": "2001",
      "ResultDesc": "The initiator information is invalid."
    },
    "transformers": ["response-template"]
  }
}
