            <stringProp name="Argument.value">${__P(AIRTEL_PAYBILL_HEADER_SHORTCODE,24322607)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AIRTEL_PAYBILL_SHORTCODE" elementType="Argument">
            <stringProp name="Argument.name">AIRTEL_PAYBILL_SHORTCODE</stringProp>
            <stringProp name="Argument.value">${__P(AIRTEL_PAYBILL_SHORTCODE,789012)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AIRTEL_PAYBILL_ACCOUNT_NUMBER" elementType="Argument">
            <stringProp name="Argument.name">AIRTEL_PAYBILL_ACCOUNT_NUMBER</stringProp>
