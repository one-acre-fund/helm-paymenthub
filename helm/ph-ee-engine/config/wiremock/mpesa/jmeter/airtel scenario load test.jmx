<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="paymenthub-collection mpesa/mtn/airtel scenario load test" enabled="true">
      <stringProp name="TestPlan.comments">Drives the /channel/channel/collection flow across every phone-number scenario documented in config/wiremock/{mpesa,mtn,airtel}/README.md (success, synchronous provider errors, failing callbacks, and the never-delivered callback). One collection thread group per connector, each cycling its own *_scenarios.csv at a steady 50 requests/minute for 5 minutes (150 req/min of collections by default); plus an airtel paybill group sending validation + confirmation pairs that share one unique transactionId, at 50 transactions/minute. Set a group&apos;s *_THREADS property to 0 to skip it. Point HOST/PROTOCOL/PORT at whichever environment has paymenthub-wiremock enabled (default: the QA channel host).</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(PROTOCOL,https)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(HOST,paymenthub.qa.oneacrefund.org)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(PORT,443)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FINERACT_ACCOUNT_ID" elementType="Argument">
            <stringProp name="Argument.name">FINERACT_ACCOUNT_ID</stringProp>
            <stringProp name="Argument.value">${__P(FINERACT_ACCOUNT_ID,43810827)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MPESA_TENANT" elementType="Argument">
            <stringProp name="Argument.name">MPESA_TENANT</stringProp>
            <stringProp name="Argument.value">${__P(MPESA_TENANT,kenya)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MPESA_AMOUNT" elementType="Argument">
            <stringProp name="Argument.name">MPESA_AMOUNT</stringProp>
            <stringProp name="Argument.value">${__P(MPESA_AMOUNT,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MPESA_CURRENCY" elementType="Argument">
            <stringProp name="Argument.name">MPESA_CURRENCY</stringProp>
            <stringProp name="Argument.value">${__P(MPESA_CURRENCY,KES)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MTN_TENANT" elementType="Argument">
            <stringProp name="Argument.name">MTN_TENANT</stringProp>
            <stringProp name="Argument.value">${__P(MTN_TENANT,rwanda)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MTN_AMOUNT" elementType="Argument">
            <stringProp name="Argument.name">MTN_AMOUNT</stringProp>
            <stringProp name="Argument.value">${__P(MTN_AMOUNT,15)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="MTN_CURRENCY" elementType="Argument">
            <stringProp name="Argument.name">MTN_CURRENCY</stringProp>
            <stringProp name="Argument.value">${__P(MTN_CURRENCY,RWF)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AIRTEL_TENANT" elementType="Argument">
            <stringProp name="Argument.name">AIRTEL_TENANT</stringProp>
            <stringProp name="Argument.value">${__P(AIRTEL_TENANT,rwanda)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AIRTEL_AMOUNT" elementType="Argument">
            <stringProp name="Argument.name">AIRTEL_AMOUNT</stringProp>
            <stringProp name="Argument.value">${__P(AIRTEL_AMOUNT,15)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
