      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="squad headers" enabled="true">
        <collectionProp name="HeaderManager.headers">
        <elementProp name="" elementType="Header">
          <stringProp name="Header.name">content-type</stringProp>
          <stringProp name="Header.value">application/json</stringProp>
        </elementProp>
        <elementProp name="" elementType="Header">
          <stringProp name="Header.name">x-squad-signature</stringProp>
          <stringProp name="Header.value">${squadSignature}</stringProp>
        </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="record transaction" enabled="true">
        <boolProp name="resetInterpreter">false</boolProp>
        <stringProp name="parameters">squad|webhook|SUCCESS|final|${squadReference}</stringProp>
        <stringProp name="filename">${PLAN_DIR}/record_transaction.bsh</stringProp>
        <stringProp name="script"></stringProp>
      </BeanShellPostProcessor>
