      <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="squad - POST /channel/squad/transactions" enabled="true">
        <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
          <collectionProp name="Arguments.arguments">
            <elementProp name="" elementType="HTTPArgument">
              <boolProp name="HTTPArgument.always_encode">false</boolProp>
              <stringProp name="Argument.value">${squadBody}</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
          </collectionProp>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
        <stringProp name="HTTPSampler.port">${PORT}</stringProp>
        <stringProp name="HTTPSampler.protocol">${PROTOCOL}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.path">/channel/squad/transactions</stringProp>
        <stringProp name="HTTPSampler.method">POST</stringProp>
        <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
        <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
        <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
        <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
        <stringProp name="HTTPSampler.connect_timeout"></stringProp>
        <stringProp name="HTTPSampler.response_timeout"></stringProp>
      </HTTPSamplerProxy>
      <hashTree>
      <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="build and sign webhook" enabled="true">
        <boolProp name="resetInterpreter">false</boolProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="script">import javax.crypto.Mac;
      import javax.crypto.spec.SecretKeySpec;

      // Read from the environment so that the secret never appears on a command line.
      String secret = System.getenv("SQUAD_SECRET_KEY");
      if (secret == null || secret.length() == 0) {
          throw new IllegalStateException("Set SQUAD_SECRET_KEY to run the squad thread group");
      }
      String reference = "PBS" + System.currentTimeMillis() + ctx.getThreadNum() + (10000 + new java.util.Random().nextInt(90000));
      String amount = props.getProperty("SQUAD_AMOUNT", "999");
      String body = "{\"transaction_reference\":\"" + reference + "\","
          + "\"virtual_account_number\":\"" + props.getProperty("SQUAD_VIRTUAL_ACCOUNT", "0917116240") + "\","
          + "\"principal_amount\":\"" + amount + "\","
          + "\"settled_amount\":\"" + amount + "\","
          + "\"fee_charged\":\"0.00\","
          + "\"transaction_date\":\"" + java.time.Instant.now() + "\","
          + "\"customer_identifier\":\"" + props.getProperty("SQUAD_CUSTOMER_IDENTIFIER", "RTEST5UMKKK3R") + "\","
          + "\"transaction_indicator\":\"C\","
          + "\"remarks\":\"load test\","
          + "\"currency\":\"NGN\","
          + "\"channel\":\"virtual-account\","
          + "\"sender_name\":\"LOAD TEST\","
          + "\"meta\":{\"freeze_transaction_ref\":null,\"reason_for_frozen_transaction\":null}}";
      Mac mac = Mac.getInstance("HmacSHA512");
      mac.init(new SecretKeySpec(secret.getBytes("UTF-8"), "HmacSHA512"));
      // Same format as PosPaymentUtils.isValidSignature in the channel connector.
      String signature = String.format("%040x", new Object[] {new java.math.BigInteger(1, mac.doFinal(body.getBytes("UTF-8")))});
      vars.put("squadReference", reference);
      vars.put("squadBody", body);
      vars.put("squadSignature", signature);
      </stringProp>
      </BeanShellPreProcessor>
      <hashTree/>
      <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="50 requests per minute" enabled="true">
        <stringProp name="throughput">${__P(SQUAD_THROUGHPUT_PER_MIN,50)}</stringProp>
        <intProp name="calcMode">2</intProp>
      </ConstantThroughputTimer>
