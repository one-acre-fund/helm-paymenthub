<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="paymenthub collection and paybill load test" enabled="true">
      <stringProp name="TestPlan.comments">Drives the collection and paybill APIs across the scenarios in the wiremock READMEs and the requests in the Payment Hub Bruno collection, and writes a manifest of every transaction for reconcile_with_ops.py. See README.md.</stringProp>
